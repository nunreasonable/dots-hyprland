  "unsupported": [
    {"keys": "Ctrl+Alt+Delete", "hyprland": "sessionToggle", "reason": "Ctrl+Alt+Delete is the secure attention sequence; no program ever sees it. The session menu is on the bar."},
    {"keys": "Ctrl+Shift+Alt+Super+Delete", "hyprland": "systemctl poweroff", "reason": "contains Ctrl+Alt+Delete (secure attention sequence)"},
    {"keys": "XF86MonBrightnessUp/Down", "hyprland": "brightness increment/decrement", "reason": "Windows has no virtual keys for brightness; laptop firmware handles those keys"},
    {"keys": "XF86AudioRaiseVolume/LowerVolume/Mute, XF86AudioPlay/Pause/Next/Prev", "hyprland": "wpctl / playerctl", "reason": "Windows handles the media keys natively (system volume, current media session); ii's OSD follows the system volume"},
    {"keys": "Alt+XF86AudioMute, XF86AudioMicMute, Super+Alt+M", "hyprland": "wpctl set-mute @DEFAULT_SOURCE@", "reason": "no virtual key for mic mute and ii has no IPC target or global shortcut for it"},
    {"keys": "Print, Ctrl+Print", "hyprland": "grim fullscreen screenshot", "reason": "left to Windows (Print Screen / Snipping Tool); Super+Shift+S is ii's region snip"},
    {"keys": "Ctrl+Alt+R, Super+Shift+Alt+R", "hyprland": "record.sh --fullscreen [--sound]", "reason": "script based recording; ii's region recorder is Super+Shift+R"},
    {"keys": "Super+Shift+Alt+mouse:273/275/276, Super+mouse wheel", "hyprland": "AI summary, playerctl, workspace scroll", "reason": "mouse binds are not supported (Super+left/right drag to move/resize windows is built in, see windowsPort.superDrag)"},
    {"keys": "Super+Shift+Alt+Q", "hyprland": "hyprctl kill (click a window to kill it)", "reason": "no kill mode, and the Windows Hyprland module has no forcekillactive dispatcher yet"},
    {"keys": "Super+Alt+F", "hyprland": "fullscreenstate (spoof)", "reason": "no equivalent"},
    {"keys": "Super+S, Ctrl+Super+S, Super+Alt+S", "hyprland": "special workspace (scratchpad)", "reason": "virtual desktops have no scratchpad"},
    {"keys": "Super+W, Super+C, Ctrl+Shift+Alt+Super+W", "hyprland": "browser / code editor / office", "reason": "no default browser launcher or editor ships with Windows; add your own exec binds"},
    {"keys": "Super+code:N, Super+Alt+code:N (number row and keypad keycodes)", "hyprland": "workspace binds", "reason": "virtual keys for the number row are layout independent already; keypad digits are not bound"},
    {"keys": "Super+Alt+F1", "hyprland": "virtual-machine submap", "reason": "submaps are not supported"},
    {"keys": "Super+Alt+F11/F12/Equal, Alt+F4", "hyprland": "test notifications / close hint", "reason": "Linux notification tests; Alt+F4 closes windows natively"},
    {"keys": "Ctrl+Super+Backslash", "hyprland": "resize to 640x480", "reason": "no equivalent"}
  ]
}
