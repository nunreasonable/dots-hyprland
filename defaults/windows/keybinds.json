{
  "about": [
    "ii keybinds for Windows, ported from dots/.config/hypr/hyprland/keybinds.lua.",
    "Copy to %LOCALAPPDATA%\\illogical-impulse\\keybinds.json to customize; that file wins over this one and is reloaded on save.",
    "keys: Ctrl+Alt+Shift+Super+<key>, or a lone modifier (\"Super\"): with onRelease it fires when tapped alone, otherwise on press and release.",
    "action: global (GlobalShortcut name, appid:name), dispatch (Hyprland.dispatch), exec (command; %SHELL% = config dir, %VAR% = environment; \"cmd1 || cmd2\" tries cmd2 if cmd1 isn't found, e.g. for a program missing on older Windows versions; console programs open in a console window of their own, `conhost.exe --headless <command>` runs one hidden), ipc (target, function, args), key (inject a key), reload, native (Windows or Quickshell handles it; listed for the cheatsheet only; keys may name a mouse button such as mouse:272).",
    "repeat: fire again on key auto-repeat. description: \"Section: text\" shows in the cheatsheet."
  ],
  "binds": [
    {"keys": "Super", "action": "global", "name": "searchToggleRelease", "onRelease": true, "description": "Shell: Toggle search"},
    {"keys": "Super", "action": "global", "name": "workspaceNumber"},
    {"keys": "Super+Tab", "action": "global", "name": "overviewWorkspacesToggle", "description": "Shell: Toggle overview"},
    {"keys": "Super+V", "action": "global", "name": "overviewClipboardToggle", "description": "Utilities: Clipboard history >> clipboard"},
    {"keys": "Super+Period", "action": "global", "name": "overviewEmojiToggle", "description": "Utilities: Emoji >> clipboard"},
    {"keys": "Super+A", "action": "global", "name": "sidebarLeftToggle", "description": "Shell: Toggle left sidebar"},
    {"keys": "Alt+Super+A", "action": "global", "name": "sidebarLeftToggleDetach"},
    {"keys": "Super+B", "action": "global", "name": "sidebarLeftToggle"},
    {"keys": "Super+O", "action": "global", "name": "sidebarLeftToggle"},
    {"keys": "Super+N", "action": "global", "name": "sidebarRightToggle", "description": "Shell: Toggle right sidebar"},
    {"keys": "Super+Slash", "action": "global", "name": "cheatsheetToggle", "description": "Shell: Toggle cheatsheet"},
    {"keys": "Super+K", "action": "global", "name": "oskToggle", "description": "Shell: Toggle on-screen keyboard"},
    {"keys": "Super+M", "action": "global", "name": "mediaControlsToggle", "description": "Shell: Toggle media controls"},
    {"keys": "Super+G", "action": "global", "name": "overlayToggle", "description": "Shell: Toggle widget overlay"},
    {"keys": "Super+J", "action": "global", "name": "barToggle", "description": "Shell: Toggle bar"},
    {"keys": "Shift+Super+W", "action": "global", "name": "desktopMenuToggle", "description": "Shell: Toggle desktop menu"},
    {"keys": "Alt+Shift+Super+Slash", "action": "exec", "command": "qsw.exe -p \"%SHELL%/welcome.qml\""},
    {"keys": "Ctrl+Super+T", "action": "global", "name": "wallpaperSelectorToggle", "description": "Shell: Change wallpaper"},
    {"keys": "Ctrl+Alt+Super+T", "action": "global", "name": "wallpaperSelectorRandom", "description": "Shell: Random wallpaper"},
    {"keys": "Ctrl+Shift+Super+D", "action": "global", "name": "toggleLightDark", "description": "Shell: Toggle light/dark mode"},
    {"keys": "Ctrl+Super+R", "action": "reload", "description": "Shell: Restart widgets"},
    {"keys": "Ctrl+Super+P", "action": "global", "name": "panelFamilyCycle", "description": "Shell: Windows taskbar instead of ii's bar (toggle)"},
    {"keys": "Shift+Super+S", "action": "global", "name": "regionScreenshot", "description": "Utilities: Screen snip"},
    {"keys": "Shift+Super+A", "action": "global", "name": "regionSearch", "description": "Utilities: Google Lens"},
    {"keys": "Shift+Super+X", "action": "global", "name": "regionOcr", "description": "Utilities: Character recognition >> clipboard"},
    {"keys": "Shift+Super+T", "action": "global", "name": "screenTranslate", "description": "Utilities: Translate screen content"},
    {"keys": "Shift+Super+C", "action": "global", "name": "colorPicker", "description": "Utilities: Pick color #RRGGBB >> clipboard"},
    {"keys": "Shift+Super+R", "action": "global", "name": "regionRecord", "description": "Utilities: Record region (no sound)"},
    {"keys": "Alt+Super+R", "action": "global", "name": "regionRecord"},
    {"keys": "Super+Minus", "action": "native", "description": "Screen: Zoom out"},
